iridanext {
    enabled = true
    output {
        path = "${params.outdir}/iridanext.output.json.gz"
        overwrite = true
        validate = false
        files {
            idkey = 'external_id'
            global = []
            samples = [
                "**/*_consensus.fasta",
                "**/QC/*_depth.pdf",
                "**/QC/*_multiqc.html",
                "**/QC/*_TrimReport.html",
                "**/*_variants.pdf",
                "**/*_variants_annot.vcf",
                "**/*_variants_annot_filtered.tsv"
            ]
        }
    }
}